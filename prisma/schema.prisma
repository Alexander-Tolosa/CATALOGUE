generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  tracks       UserTrack[]
  progress     UserProgress[]
  certificates Certificate[]
  reviewItems  ReviewItem[]
  streaks      Streak?
  kleoState    KleoState?
  chatMessages ChatMessage[]
}

model Language {
  id           String        @id @default(uuid())
  name         String
  code         String        @unique // 'en' | 'ko' | 'ja'
  levels       Level[]
  certificates Certificate[]
}

model Level {
  id           String         @id @default(uuid())
  languageId   String
  language     Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)
  code         String         // e.g. 'A1', 'TOPIK_1', 'N5'
  name         String         // e.g. 'Beginner', 'TOPIK I - Level 1', 'Basic (N5)'
  order        Int            // 0, 1, 2, ...
  description  String
  lessons      Lesson[]
  quizzes      Quiz[]
  progress     UserProgress[]
  certificates Certificate[]

  @@unique([languageId, code])
  @@unique([languageId, order])
}

model Lesson {
  id      String @id @default(uuid())
  levelId String
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  title   String
  content String
  order   Int
}

model Quiz {
  id            String     @id @default(uuid())
  levelId       String
  level         Level      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  passThreshold Float      @default(0.8)
  questions     Question[]
}

model Question {
  id            String @id @default(uuid())
  quizId        String
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt        String
  choices       String // JSON array string e.g. ["choice 1", "choice 2"]
  correctAnswer String
}

model UserProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  levelId     String
  level       Level     @relation(fields: [levelId], references: [id], onDelete: Cascade)
  status      String    @default("locked") // 'locked' | 'in_progress' | 'passed'
  bestScore   Float?
  completedAt DateTime?

  @@unique([userId, levelId])
}

model Certificate {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageId      String
  language        Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  levelId         String
  level           Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  issuedAt        DateTime @default(now())
  certificateCode String   @unique
  pdfUrl          String

  @@unique([userId, levelId])
}

model UserTrack {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language    String   // 'ko' | 'ja' | 'en'
  currentUnit Int      @default(1)
  dailyGoal   Int      @default(10) // minutes
  updatedAt   DateTime @updatedAt

  @@unique([userId, language])
}

model Vocabulary {
  id          String       @id @default(uuid())
  language    String
  term        String
  translation String
  audioUrl    String?
  reviewItems ReviewItem[]
}

model ReviewItem {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyId String
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  interval     Int        @default(1) // days
  easeFactor   Float      @default(2.5) // SM-2 ease factor
  nextReviewAt DateTime   @default(now())
  createdAt    DateTime   @default(now())
}

model Streak {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int      @default(1)
  longestStreak  Int      @default(1)
  lastActiveDate DateTime @default(now())
}

model KleoState {
  id                String @id @default(uuid())
  userId            String @unique
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bondXp            Int    @default(0)
  mood              String @default("happy") // 'happy' | 'curious' | 'encouraging' | 'nuzzling' | 'celebrating' | 'sleepy'
  equippedCosmetics String @default("{}") // JSON string of equipped cosmetics
  unlockedCosmetics String @default("[\"blue_beret\"]") // JSON array
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // 'user' | 'assistant'
  content   String
  createdAt DateTime @default(now())
}
